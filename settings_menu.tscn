[gd_scene format=3]

[ext_resource type="Script" path="res://settings_menu.gd" id="1_settings"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_settings"]
bg_color = Color(0.05, 0.07, 0.09, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.75, 0.7, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8

[node name="SettingsMenu" type="Control"]
process_mode = 3
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
script = ExtResource("1_settings")

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.01, 0.02, 0.03, 0.72)

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -210.0
offset_top = -170.0
offset_right = 210.0
offset_bottom = 170.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_settings")

[node name="VBoxContainer" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.35, 0.85, 0.8, 1)
theme_override_font_sizes/font_size = 34
text = "SETTINGS"
horizontal_alignment = 1

[node name="VolumeLabel" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "MASTER VOLUME"

[node name="VolumeSlider" type="HSlider" parent="Panel/VBoxContainer"]
custom_minimum_size = Vector2(0, 32)
layout_mode = 2
min_value = -40.0
max_value = 0.0
step = 1.0
value = -6.0

[node name="FullscreenCheck" type="CheckButton" parent="Panel/VBoxContainer"]
layout_mode = 2
text = "Fullscreen"

[node name="Back" type="Button" parent="Panel/VBoxContainer"]
layout_mode = 2
focus_mode = 2
text = "Back"

[connection signal="value_changed" from="Panel/VBoxContainer/VolumeSlider" to="." method="_on_volume_changed"]
[connection signal="toggled" from="Panel/VBoxContainer/FullscreenCheck" to="." method="_on_fullscreen_toggled"]
[connection signal="pressed" from="Panel/VBoxContainer/Back" to="." method="_on_back_pressed"]
